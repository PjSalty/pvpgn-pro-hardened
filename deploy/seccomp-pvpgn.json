{
  "//": "Seccomp allowlist for bnetd. defaultAction denies with EPERM. This is a static, single-process network daemon: it needs sockets, epoll/poll/select, file I/O for the account DB and config, memory, signals, and time. It needs none of the process-escape syscalls (ptrace, keyctl, mount, bpf, kexec, add_key, unshare, clone of new namespaces), which are denied by omission. Verified by booting the daemon and serving a bnet handshake under this profile; widen only if a legitimate syscall is denied.",
  "defaultAction": "SCMP_ACT_ERRNO",
  "defaultErrnoRet": 1,
  "archMap": [
    { "architecture": "SCMP_ARCH_X86_64", "subArchitectures": ["SCMP_ARCH_X86", "SCMP_ARCH_X32"] },
    { "architecture": "SCMP_ARCH_AARCH64", "subArchitectures": ["SCMP_ARCH_ARM"] }
  ],
  "syscalls": [
    {
      "names": [
        "accept", "accept4", "bind", "listen", "connect", "socket", "socketpair",
        "getsockname", "getpeername", "getsockopt", "setsockopt", "shutdown",
        "recvfrom", "recvmsg", "sendto", "sendmsg", "recv", "send",
        "execve", "execveat",
        "setuid", "setgid", "setgroups", "setresuid", "setresgid",
        "setuid32", "setgid32", "setgroups32", "setresuid32", "setresgid32",
        "read", "readv", "pread64", "write", "writev", "pwrite64",
        "open", "openat", "openat2", "close", "close_range", "creat",
        "stat", "fstat", "lstat", "newfstatat", "statx", "fstatfs", "statfs",
        "lseek", "fcntl", "fcntl64", "flock", "fsync", "fdatasync", "ftruncate",
        "getdents", "getdents64", "readlink", "readlinkat", "access", "faccessat", "faccessat2",
        "rename", "renameat", "renameat2", "link", "linkat", "symlink", "symlinkat",
        "unlink", "unlinkat", "mkdir", "mkdirat", "rmdir", "chmod", "fchmod", "fchmodat",
        "chown", "fchown", "fchownat", "umask", "utime", "utimes", "utimensat", "futimesat",
        "dup", "dup2", "dup3", "pipe", "pipe2",
        "epoll_create", "epoll_create1", "epoll_ctl", "epoll_wait", "epoll_pwait", "epoll_pwait2",
        "poll", "ppoll", "select", "pselect6", "eventfd", "eventfd2",
        "mmap", "mmap2", "munmap", "mremap", "mprotect", "madvise", "brk", "mlock", "munlock",
        "rt_sigaction", "rt_sigprocmask", "rt_sigreturn", "rt_sigpending", "rt_sigsuspend",
        "sigaltstack", "kill", "tgkill", "tkill", "signalfd", "signalfd4", "restart_syscall",
        "nanosleep", "clock_nanosleep", "clock_gettime", "clock_getres", "gettimeofday", "time",
        "getpid", "gettid", "getppid", "getuid", "geteuid", "getgid", "getegid",
        "getgroups", "getresuid", "getresgid", "getpgrp", "getpgid", "getsid",
        "setrlimit", "getrlimit", "prlimit64", "getpriority", "sched_getaffinity", "sched_yield",
        "uname", "sysinfo", "getrandom", "getcwd", "chdir", "fchdir",
        "arch_prctl", "set_tid_address", "set_robust_list", "get_robust_list",
        "futex", "futex_time64", "wait4", "waitid", "exit", "exit_group",
        "ioctl", "prctl", "membarrier", "rseq", "clone3", "clone"
      ],
      "action": "SCMP_ACT_ALLOW"
    }
  ]
}
